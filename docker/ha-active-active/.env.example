# Active-active (N-way Multi-Master). All nodes accept writes.

# Server identity (1, 2, 3...). Must be unique per node.
SERVER_ID=1

# Comma-separated list of peer LDAP URIs (include self). Order = serverID order.
NODE_URIS=ldap://192.168.58.10:389,ldap://192.168.58.11:389,ldap://192.168.58.12:389

# Replicator account credentials (used by syncrepl between peers)
REPLICATOR_DN=cn=replicator,ou=service-accounts,dc=example,dc=org
REPLICATOR_PASSWORD=replicatorpassword

# --- cn=config replication (optional) ---------------------------------------
# false (default): only dc=example,dc=org replicates. ACLs, overlays, schema
#   and ppolicy changes applied on one node stay on that node.
# true: the cn=config database replicates too, so those changes propagate.
#   Consequences, all handled automatically by setup-node.sh:
#     - olcServerID switches to the URL form (mandatory: the single-int form
#       would be overwritten by the peer's own value once cn=config syncs)
#     - a syncprov overlay is added on olcDatabase={0}config
#     - docker-compose.override.yml pins slapd's listeners so the URL matches
#   Every node MUST run with the same value and the same CONFIG_ADMIN_PASSWORD.
REPLICATE_CONFIG=false

# rootDN password of the cn=config database (cn=adminconfig,cn=config).
# Must be IDENTICAL on every node: it is the bind credential of the cn=config
# syncrepl consumer. Default matches the value documented in docker/README.md.
CONFIG_ADMIN_PASSWORD=adminpasswordconfig

# HAProxy stats UI auth
HAPROXY_STATS_USER=admin
HAPROXY_STATS_PASSWORD=admin

# Expose phpLDAPadmin on this node (true/false). Typically only node 1.
ENABLE_PHPLDAPADMIN=false

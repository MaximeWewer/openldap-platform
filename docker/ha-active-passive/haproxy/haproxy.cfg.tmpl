global
    log stdout format raw local0
    maxconn 4096
    daemon

defaults
    log     global
    mode    tcp
    option  tcplog
    option  dontlognull
    # LDAP clients hold pooled connections open and idle between operations,
    # and syncrepl consumers keep a refreshAndPersist session open for good.
    # At 1m both were being cut mid-flight and had to rebind constantly, which
    # shows up as connection churn and spurious bind load on the servers.
    timeout connect 5s
    timeout client  10m
    timeout server  10m
    # Keepalives on both sides so a genuinely dead peer is still detected well
    # before the (now much longer) idle timeout fires.
    option  clitcpka
    option  srvtcpka
    timeout check   3s

# === Stats UI (HTTP) ===
frontend stats
    mode http
    bind *:8404
    stats enable
    stats uri /
    stats refresh 10s
    stats auth @@HAPROXY_STATS_USER@@:@@HAPROXY_STATS_PASSWORD@@

# === LDAP (plaintext) - WRITE path ===
# Masters only (SERVER_ID 1-2). Consumers are deliberately absent: they run
# without olcMirrorMode, so slapd answers any write on them with
# `shadow context; no update referral`. Listing them here as backups meant a
# double-master outage failed over onto a node that cannot accept writes.
frontend ldap_front
    bind *:1389
    mode tcp
    default_backend ldap_back

backend ldap_back
    mode tcp
    balance first
    option ldap-check
@@LDAP_SERVERS@@

# === LDAPS (TLS passthrough) - WRITE path ===
frontend ldaps_front
    bind *:1636
    mode tcp
    default_backend ldaps_back

backend ldaps_back
    mode tcp
    balance first
    option tcp-check
    tcp-check connect
@@LDAPS_SERVERS@@
@@READONLY_SECTION@@

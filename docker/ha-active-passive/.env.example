# Active-passive (MirrorMode + read-only consumers).
# SERVER_ID 1+2 are masters (HAProxy: 1 active, 2 backup). SERVER_ID >=3 are read-only consumers.

SERVER_ID=1
NODE_URIS=ldap://192.168.58.10:389,ldap://192.168.58.11:389,ldap://192.168.58.12:389

REPLICATOR_DN=cn=replicator,ou=service-accounts,dc=example,dc=org
REPLICATOR_PASSWORD=replicatorpassword

# --- cn=config replication (optional, MASTERS ONLY) -------------------------
# false (default): only dc=example,dc=org replicates. ACLs, overlays, schema
#   and ppolicy changes applied on one master stay on that master.
#   Off by default (unlike the Helm chart, which defaults ON): enabling it
#   needs network_mode: host + an olcServerID URL the container can bind
#   locally, which bridge/NAT/cross-DC topologies may not satisfy (slapd would
#   then refuse to start). Turn on only where your topology supports it;
#   otherwise manage cn=config on both nodes out-of-band. See README.
# true: cn=config replicates between SERVER_ID 1 and 2, so those changes
#   propagate. Consumers (SERVER_ID >= 3) get the cn=schema subtree ONLY -
#   consuming the whole cn=config would hand them olcMirrorMode: TRUE and stop
#   them being read-only, but without the schema their syncrepl stalls
#   silently on any entry using a runtime-added objectClass.
#   Set the same value and CONFIG_ADMIN_PASSWORD on EVERY node.
REPLICATE_CONFIG=false

# rootDN password of the cn=config database (cn=adminconfig,cn=config).
# Must be IDENTICAL on every node: it is the bind credential of the cn=config
# syncrepl consumer. Default matches the value documented in docker/README.md.
CONFIG_ADMIN_PASSWORD=adminpasswordconfig

HAPROXY_STATS_USER=admin
HAPROXY_STATS_PASSWORD=admin

ENABLE_PHPLDAPADMIN=false

.vagrant/

# Persistent OpenLDAP data (per-mode)
docker/standalone/data/
docker/ha-active-active/data/
docker/ha-active-passive/data/

# Rendered by setup.sh from ssp.conf.php.example (carries a per-deployment
# keyphrase used to encrypt SSP reset tokens)
docker/standalone/ssp.conf.php
docker/ha-active-active/ssp.conf.php
docker/ha-active-passive/ssp.conf.php

# Per-mode env + rendered HAProxy config
docker/standalone/.env
docker/ha-active-active/.env
docker/ha-active-passive/.env
docker/ha-active-active/haproxy/haproxy.cfg
docker/ha-active-passive/haproxy/haproxy.cfg

# Rendered by setup-node.sh when REPLICATE_CONFIG=true (pins slapd listeners)
docker/ha-active-active/docker-compose.override.yml
docker/ha-active-passive/docker-compose.override.yml

# TLS material (generated locally per mode)
docker/*/certs/*.crt
docker/*/certs/*.key
docker/*/certs/*.csr
docker/*/certs/*.srl

# Backup dumps (generated per mode)
docker/*/backup/*.tar.gz
docker/*/backup/*.tgz

# Helm - derived subchart archives from `helm dependency update` on
# file:// deps. Chart.lock too (SHAs would drift per-dev on file:// deps).
kubernetes/charts/*/charts/*.tgz
kubernetes/charts/*/Chart.lock
